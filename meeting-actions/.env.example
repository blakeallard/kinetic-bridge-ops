# Bevco Meeting Actions — environment variables
# Copy to .env for local runs. On Railway, set these as service variables.
# NEVER commit a real .env.

# OpenAI (worksheet-based task extraction)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Zoho OAuth (self-client refresh-token flow — same creds as the transcriber)
# The refresh token MUST be minted with these Zoho Projects scopes.
# Required minimum:
#   ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasks.READ,ZohoProjects.tasks.CREATE
# Preferred:
#   ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasks.ALL
# Optional (only if ATTACH_WORKSHEET_HTML=1):
#   ZohoProjects.attachments.ALL
# A token without tasks.READ causes 403 on the dedupe fetch; without
# tasks.CREATE, task creation 403s. Re-mint the refresh token if scopes change.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho endpoints (defaults shown; override for non-.com data centers)
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# ZOHO_PROJECTS_API_BASE=https://projectsapi.zoho.com

# Defaults used when the webhook payload has no numeric portal/project id
ZOHO_PORTAL_ID=898600220
ZOHO_PROJECT_ID=2543412000001324010

# Optional
# ATTACH_WORKSHEET_HTML=1          # attach full worksheet HTML to each created task
# STATE_FILE=/data/processed_notes.json   # point at a Railway volume for durable dedupe
# LOG_LEVEL=INFO
# PORT is injected by Railway automatically
