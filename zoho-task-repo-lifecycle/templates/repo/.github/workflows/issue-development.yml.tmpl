name: Prepare issue development

on:
  issues:
    types: [opened]

permissions:
  contents: write
  issues: write

jobs:
  prepare-development:
    if: github.event.issue.number == 1 || contains(github.event.issue.title, 'Implement') || contains(github.event.issue.title, 'implement')
    runs-on: ubuntu-latest
    steps:
      - name: Label issue and prepare development branch
        uses: actions/github-script@v8
        with:
          script: |
            const owner = context.repo.owner;
            const repo = context.repo.repo;
            const issue = context.payload.issue;
            const standardLabels = [
              {name: 'zoho-task', color: '0e8a16', description: 'Work originating from Zoho Projects'},
              {name: 'implementation', color: '1d76db', description: 'Implementation work'},
              {name: 'ai-assisted', color: '5319e7', description: 'AI-assisted development workflow'}
            ];
            for (const label of standardLabels) {
              try {
                await github.rest.issues.getLabel({owner, repo, name: label.name});
              } catch (error) {
                if (error.status !== 404) throw error;
                await github.rest.issues.createLabel({owner, repo, ...label});
              }
            }
            await github.rest.issues.addLabels({
              owner, repo, issue_number: issue.number,
              labels: standardLabels.map(label => label.name)
            });

            const repository = await github.rest.repos.get({owner, repo});
            const base = repository.data.default_branch;
            const baseRef = await github.rest.git.getRef({owner, repo, ref: `heads/${base}`});
            const slug = issue.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'implementation';
            const branch = `issue-${issue.number}-${slug}`;
            try {
              await github.rest.git.createRef({owner, repo, ref: `refs/heads/${branch}`, sha: baseRef.data.object.sha});
            } catch (error) {
              if (error.status !== 422) throw error;
            }

            const marker = '<!-- issue-development-prepared -->';
            const comments = await github.paginate(github.rest.issues.listComments, {owner, repo, issue_number: issue.number});
            if (!comments.some(comment => comment.body?.includes(marker))) {
              await github.rest.issues.createComment({
                owner, repo, issue_number: issue.number,
                body: `${marker}\nDevelopment metadata prepared.\n\n- Base: \`${base}\`\n- Branch: \`${branch}\`\n- Review: changes must be submitted through a pull request; no automatic merge is enabled.`
              });
            }
