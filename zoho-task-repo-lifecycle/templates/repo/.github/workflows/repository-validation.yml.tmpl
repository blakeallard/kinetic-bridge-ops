name: Repository validation

on:
  push:
  pull_request:

jobs:
  validate-scaffold:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - name: Verify required lifecycle files
        shell: bash
        run: |
          set -euo pipefail
          required=(
            README.md TASK.md STATUS.md AGENTS.md CLAUDE.md CODEX.md
            .github/workflows/agent-readiness.yml
            .github/workflows/python-quality.yml
            .github/workflows/repository-validation.yml
            .github/workflows/claude-context-check.yml
            .github/workflows/issue-development.yml
            .github/workflows/pr-validation.yml
            .github/workflows/security.yml
            .github/workflows/sync-commits-to-zoho.yml
            .zoho-project-task.json
            scripts/sync_commits_to_zoho.py
          )
          for path in "${required[@]}"; do
            [[ -f "$path" ]] || { echo "::error file=$path::Missing required lifecycle file"; exit 1; }
            grep -q 'Generated by zoho-task-repo-lifecycle' "$path" || { echo "::error file=$path::Missing lifecycle generator marker"; exit 1; }
            grep -Eq 'Task: [A-Za-z0-9_.-]+' "$path" || { echo "::error file=$path::Missing task ownership marker"; exit 1; }
            grep -Eq 'Repository lifecycle version: [A-Za-z0-9_.-]+' "$path" || { echo "::error file=$path::Missing lifecycle version marker"; exit 1; }
          done
          for path in docs scripts artifacts .github/ISSUE_TEMPLATE .github/workflows; do
            [[ -d "$path" ]] || { echo "::error file=$path::Missing required lifecycle directory"; exit 1; }
          done
          task_key="$(sed -nE 's/.*Task: ([A-Za-z0-9_.-]+).*/\1/p' TASK.md | head -n1)"
          [[ "$task_key" =~ ^[A-Za-z]+[A-Za-z0-9]*-T[0-9]+$ ]] || { echo "::error file=TASK.md::Invalid task key metadata"; exit 1; }
          grep -q "Task key: \`$task_key\`" TASK.md || { echo "::error file=TASK.md::Task metadata does not match ownership marker"; exit 1; }
          grep -Eq 'Zoho Task ID: [0-9]+' TASK.md || { echo "::error file=TASK.md::Missing immutable Zoho task ID"; exit 1; }
          python -c 'import json; data=json.load(open(".zoho-project-task.json")); required=("required_task_tag","task_key","portal_id","project_id","task_id"); assert data["required_task_tag"] == "repo-needed" and all(str(data.get(key, "")).strip() for key in required)'
          for path in "${required[@]}"; do
            grep -q "Task: $task_key" "$path" || { echo "::error file=$path::Lifecycle ownership task mismatch"; exit 1; }
          done
          echo "Lifecycle repository contract and metadata are valid."
