/*
 * Zoho-only meeting-actions v2: conservative parser draft.
 *
 * SOURCE OF TRUTH:
 *   scripts/parse_summary.py and samples/expected/*.json
 *
 * EXPECTED ZOHO FLOW OR WORKDRIVE WRAPPER INPUT:
 *   flow_input (MAP)
 *     file_id   (TEXT) - stable WorkDrive file ID when available
 *     file_name (TEXT) - required; must end with _summary.txt
 *     file_path (TEXT) - WorkDrive display/audit path
 *     file_text (TEXT) - required; caller-fetched UTF-8 summary content
 *
 * This function does not fetch a file, call invokeurl, call Zoho Projects,
 * create a task, mutate a registry, or perform any other external write.
 * It returns a dry-run MAP containing an items LIST.
 *
 * Function signature syntax can vary by Zoho product. In a Zoho editor that
 * configures name/arguments/return type in the UI, configure:
 *   name: parse_meeting_summary
 *   argument: flow_input (KEY-VALUE / MAP)
 *   return type: KEY-VALUE / MAP
 * and paste only the body between the outer braces if required.
 */
map parse_meeting_summary(map flow_input)
{
	result = Map();
	items = List();
	errors = List();

	file_id = ifnull(flow_input.get("file_id"), "").toString().trim();
	file_name = ifnull(flow_input.get("file_name"), "").toString().trim();
	file_path = ifnull(flow_input.get("file_path"), "").toString().trim();
	file_text_value = flow_input.get("file_text");
	file_text = ifnull(file_text_value, "").toString();

	result.put("dry_run", true);
	result.put("parser_version", "deluge-draft-v1");
	result.put("file_id", file_id);
	result.put("file_name", file_name);
	result.put("file_path", file_path);

	if(file_name == "")
	{
		errors.add("file_name is required");
	}
	else if(!file_name.endsWith("_summary.txt"))
	{
		errors.add("file_name must end with _summary.txt");
	}
	if(file_text_value == null)
	{
		errors.add("file_text is required");
	}

	if(errors.size() > 0)
	{
		result.put("items", items);
		result.put("item_count", 0);
		result.put("errors", errors);
		return result;
	}

	/* Known owner aliases. IDs are configuration references, not credentials. */
	owner_map = Map();
	blake = Map();
	blake.put("canonical_name", "Blake Allard");
	blake.put("owner_id", "2543412000001324206");
	bill = Map();
	bill.put("canonical_name", "Bill Beverley");
	bill.put("owner_id", "2543412000000059003");
	bryan = Map();
	bryan.put("canonical_name", "Bryan Ovalle");
	bryan.put("owner_id", "2543412000000108001");
	owner_map.put("blake", blake);
	owner_map.put("blake allard", blake);
	owner_map.put("bill", bill);
	owner_map.put("bill beverley", bill);
	owner_map.put("bryan", bryan);
	owner_map.put("brian", bryan);
	owner_map.put("bryan ovalle", bryan);

	approved_sections = {"action item","action items","next actions","next steps"};
	known_major_headings = {"summary","meeting summary","notes","decisions","key takeaways","transcript","agenda"};

	/* Normalize line endings only. Tabs become four spaces for stable indent checks. */
	normalized_file_text = file_text.replaceAll("\r\n", "\n", true);
	normalized_file_text = normalized_file_text.replaceAll("\r", "\n", true);
	normalized_file_text = normalized_file_text.replaceAll("\t", "    ", true);
	lines = normalized_file_text.toList("\n");

	/*
	 * First pass: isolate approved sections and build raw top-level action
	 * candidates with nested Owner/Assignee and Due metadata. This stage does
	 * not resolve owners and does not infer unbulleted prose as an action.
	 */
	raw_candidates = List();
	in_section = false;
	current_body = "";
	current_indent = -1;
	current_owner_values = List();
	current_due_values = List();

	for each line in lines
	{
		trimmed = line.trim();
		heading_candidate = trimmed.replaceFirst("^#{1,6}\\s*", "");
		heading_candidate = heading_candidate.replaceFirst(":\\s*$", "").trim().toLowerCase();

		if(approved_sections.contains(heading_candidate))
		{
			if(current_body != "")
			{
				raw_candidate = Map();
				raw_candidate.put("body", current_body);
				raw_candidate.put("owner_values", current_owner_values);
				raw_candidate.put("due_values", current_due_values);
				raw_candidates.add(raw_candidate);
			}
			current_body = "";
			current_indent = -1;
			current_owner_values = List();
			current_due_values = List();
			in_section = true;
			continue;
		}

		is_bullet = line.matches("^\\s*([-*•]|[0-9]+[.)])\\s+.+$");
		is_markdown_heading = trimmed.matches("^#{1,6}\\s+.+$");
		is_known_major = known_major_headings.contains(heading_candidate);
		is_plain_generic_heading = false;
		if(line == line.ltrim() && trimmed.length() > 0 && trimmed.length() <= 80)
		{
			/* Conservative plain heading equivalent for short Title Case lines. */
			plain_heading_pattern = "^([A-Z][A-Za-z0-9'()/&-]*|and|or|of|the|to|for|in|on|&)(\\s+([A-Z][A-Za-z0-9'()/&-]*|and|or|of|the|to|for|in|on|&)){0,7}:?$";
			is_plain_generic_heading = trimmed.matches(plain_heading_pattern);
		}

		if(in_section && !is_bullet && (is_markdown_heading || is_known_major || is_plain_generic_heading))
		{
			if(current_body != "")
			{
				raw_candidate = Map();
				raw_candidate.put("body", current_body);
				raw_candidate.put("owner_values", current_owner_values);
				raw_candidate.put("due_values", current_due_values);
				raw_candidates.add(raw_candidate);
			}
			current_body = "";
			current_indent = -1;
			current_owner_values = List();
			current_due_values = List();
			in_section = false;
			continue;
		}

		if(!in_section)
		{
			continue;
		}

		if(is_bullet)
		{
			indent = line.length() - line.ltrim().length();
			body = line.replaceFirst("^\\s*([-*•]|[0-9]+[.)])\\s+", "").trim();
			body_lower = body.toLowerCase();
			is_metadata = body_lower.matches("^(owner|owners|assignee|assignees|due|due date)\\s*:.*$");

			if(is_metadata)
			{
				metadata_value = body.replaceFirst("^[^:]*:", "").trim();
				if(current_body != "" && metadata_value != "")
				{
					if(body_lower.matches("^(due|due date)\\s*:.*$"))
					{
						current_due_values.add(metadata_value);
					}
					else
					{
						current_owner_values.add(metadata_value);
					}
				}
				/* Metadata without a preceding action is intentionally ignored. */
				continue;
			}

			if(current_body != "" && indent > current_indent)
			{
				/* Nested non-metadata bullets are context, not actions. */
				continue;
			}

			if(current_body != "")
			{
				raw_candidate = Map();
				raw_candidate.put("body", current_body);
				raw_candidate.put("owner_values", current_owner_values);
				raw_candidate.put("due_values", current_due_values);
				raw_candidates.add(raw_candidate);
			}
			current_body = body;
			current_indent = indent;
			current_owner_values = List();
			current_due_values = List();
			continue;
		}

		if(current_body != "" && trimmed != "")
		{
			metadata_lower = trimmed.toLowerCase();
			if(metadata_lower.matches("^(owner|owners|assignee|assignees|due|due date)\\s*:.*$"))
			{
				metadata_value = trimmed.replaceFirst("^[^:]*:", "").trim();
				if(metadata_value != "")
				{
					if(metadata_lower.matches("^(due|due date)\\s*:.*$"))
					{
						current_due_values.add(metadata_value);
					}
					else
					{
						current_owner_values.add(metadata_value);
					}
				}
			}
			else if(line != line.ltrim())
			{
				/* Preserve an indented wrapped action line as action text. */
				current_body = current_body + " " + trimmed;
			}
		}
	}

	if(current_body != "")
	{
		raw_candidate = Map();
		raw_candidate.put("body", current_body);
		raw_candidate.put("owner_values", current_owner_values);
		raw_candidate.put("due_values", current_due_values);
		raw_candidates.add(raw_candidate);
	}

	/*
	 * Second pass: split inline metadata, resolve explicit owners, preserve raw
	 * due text, and construct the Python-compatible item shape.
	 */
	inline_marker = "|||V2_FIELD|||";
	for each raw_candidate in raw_candidates
	{
		inline_body = raw_candidate.get("body").toString().trim();
		inline_body = inline_body.replaceAll(" — ", inline_marker, true);
		inline_body = inline_body.replaceAll(" – ", inline_marker, true);
		inline_body = inline_body.replaceAllIgnoreCase(" - Owner:", inline_marker + "Owner:");
		inline_body = inline_body.replaceAllIgnoreCase(" - Owners:", inline_marker + "Owners:");
		inline_body = inline_body.replaceAllIgnoreCase(" - Assignee:", inline_marker + "Assignee:");
		inline_body = inline_body.replaceAllIgnoreCase(" - Assignees:", inline_marker + "Assignees:");
		inline_body = inline_body.replaceAllIgnoreCase(" - Due:", inline_marker + "Due:");
		inline_body = inline_body.replaceAllIgnoreCase(" - Due Date:", inline_marker + "Due Date:");
		parts = inline_body.toList(inline_marker);

		action_parts = List();
		inline_owner_values = List();
		inline_due_values = List();
		unlabeled_parts = List();
		part_index = 0;
		for each part in parts
		{
			clean_part = part.toString().trim();
			if(part_index == 0)
			{
				action_parts.add(clean_part);
			}
			else if(clean_part != "")
			{
				part_lower = clean_part.toLowerCase();
				if(part_lower.matches("^(owner|owners|assignee|assignees|due|due date)\\s*:.*$"))
				{
					metadata_value = clean_part.replaceFirst("^[^:]*:", "").trim();
					if(part_lower.matches("^(due|due date)\\s*:.*$"))
					{
						inline_due_values.add(metadata_value);
					}
					else
					{
						inline_owner_values.add(metadata_value);
					}
				}
				else
				{
					unlabeled_parts.add(clean_part);
				}
			}
			part_index = part_index + 1;
		}

		/* Positional "Action — Bill" is accepted only for known aliases. */
		if(inline_owner_values.size() == 0 && unlabeled_parts.size() > 0)
		{
			positional_owner = unlabeled_parts.get(0).toString().trim();
			positional_normalized = positional_owner.replaceAllIgnoreCase(" and ", ",");
			positional_normalized = positional_normalized.replaceAll(";", ",", true);
			positional_normalized = positional_normalized.replaceAll("/", ",", true);
			positional_normalized = positional_normalized.replaceAll("&", ",", true);
			positional_normalized = positional_normalized.replaceAll("+", ",", true);
			positional_tokens = positional_normalized.toList(",");
			all_positional_known = true;
			positional_count = 0;
			for each positional_token in positional_tokens
			{
				positional_key = positional_token.toString().trim().toLowerCase();
				positional_key = positional_key.replaceAll("^\\.+|\\.+$", "");
				if(positional_key != "")
				{
					positional_count = positional_count + 1;
					if(!owner_map.containKey(positional_key))
					{
						all_positional_known = false;
					}
				}
			}
			if(positional_count > 0 && all_positional_known)
			{
				inline_owner_values.add(positional_owner);
				unlabeled_parts.remove(0);
				if(unlabeled_parts.size() > 0 && inline_due_values.size() == 0)
				{
					inline_due_values.add(unlabeled_parts.get(0));
					unlabeled_parts.remove(0);
				}
			}
		}

		for each unlabeled_part in unlabeled_parts
		{
			action_parts.add(unlabeled_part);
		}
		action_text = "";
		for each action_part in action_parts
		{
			if(action_part.toString().trim() != "")
			{
				if(action_text != "")
				{
					action_text = action_text + " — ";
				}
				action_text = action_text + action_part.toString().trim();
			}
		}
		if(action_text == "")
		{
			continue;
		}

		owner_values = List();
		owner_values.addAll(inline_owner_values);
		owner_values.addAll(raw_candidate.get("owner_values"));
		due_values = List();
		due_values.addAll(inline_due_values);
		due_values.addAll(raw_candidate.get("due_values"));

		/* Resolve all explicit owner tokens and deduplicate known aliases by ID. */
		detected_owners = List();
		seen_owner_identities = List();
		owner_raw_values = List();
		for each owner_value in owner_values
		{
			clean_owner_value = owner_value.toString().trim();
			if(clean_owner_value == "")
			{
				continue;
			}
			if(!owner_raw_values.contains(clean_owner_value))
			{
				owner_raw_values.add(clean_owner_value);
			}

			owner_tokens_text = clean_owner_value.replaceAllIgnoreCase(" and ", ",");
			owner_tokens_text = owner_tokens_text.replaceAll(";", ",", true);
			owner_tokens_text = owner_tokens_text.replaceAll("/", ",", true);
			owner_tokens_text = owner_tokens_text.replaceAll("&", ",", true);
			owner_tokens_text = owner_tokens_text.replaceAll("+", ",", true);
			owner_tokens = owner_tokens_text.toList(",");

			for each owner_token in owner_tokens
			{
				owner_name = owner_token.toString().trim();
				owner_key = owner_name.toLowerCase().replaceAll("^\\.+|\\.+$", "").trim();
				if(owner_key == "")
				{
					continue;
				}

				detected_owner = Map();
				detected_owner.put("name", owner_name);
				if(owner_map.containKey(owner_key))
				{
					known_owner = owner_map.get(owner_key);
					identity = "id:" + known_owner.get("owner_id").toString();
					detected_owner.put("canonical_name", known_owner.get("canonical_name"));
					detected_owner.put("owner_id", known_owner.get("owner_id"));
					detected_owner.put("resolution", "matched");
				}
				else
				{
					identity = "unknown:" + owner_key;
					detected_owner.put("canonical_name", null);
					detected_owner.put("owner_id", null);
					detected_owner.put("resolution", "unresolved");
				}
				if(!seen_owner_identities.contains(identity))
				{
					seen_owner_identities.add(identity);
					detected_owners.add(detected_owner);
				}
			}
		}

		owner_raw = null;
		owner_raw_text = "";
		for each owner_raw_value in owner_raw_values
		{
			if(owner_raw_text != "")
			{
				owner_raw_text = owner_raw_text + "; ";
			}
			owner_raw_text = owner_raw_text + owner_raw_value.toString();
		}
		if(owner_raw_text != "")
		{
			owner_raw = owner_raw_text;
		}

		owner_resolution = "missing";
		resolved_owner_id = null;
		if(detected_owners.size() > 1)
		{
			owner_resolution = "multiple";
		}
		else if(detected_owners.size() == 1)
		{
			only_owner = detected_owners.get(0);
			if(only_owner.get("owner_id") == null)
			{
				owner_resolution = "unresolved";
			}
			else
			{
				owner_resolution = "matched";
				resolved_owner_id = only_owner.get("owner_id");
			}
		}

		due_date_text = null;
		due_raw_values = List();
		for each due_value in due_values
		{
			clean_due_value = due_value.toString().trim();
			if(clean_due_value != "" && !due_raw_values.contains(clean_due_value))
			{
				due_raw_values.add(clean_due_value);
			}
		}
		due_raw_text = "";
		for each due_raw_value in due_raw_values
		{
			if(due_raw_text != "")
			{
				due_raw_text = due_raw_text + "; ";
			}
			due_raw_text = due_raw_text + due_raw_value.toString();
		}
		if(due_raw_text != "")
		{
			due_date_text = due_raw_text;
		}

		/*
		 * ASCII fixtures produce the same SHA-256 identity as Python:
		 * lower/collapsed source filename + newline + lower/collapsed action.
		 * Deluge has no documented NFKC operation, so Unicode compatibility must
		 * be fixture-tested before using hashes for non-ASCII production text.
		 */
		normalized_source_name = file_name.trim().toLowerCase().replaceAll("\\s+", " ");
		normalized_action_text = action_text.trim().toLowerCase().replaceAll("\\s+", " ");
		hash_input = normalized_source_name + "\n" + normalized_action_text;
		action_hash = zoho.encryption.sha256(hash_input);

		/*
		 * Fallback for a product/runtime where SHA-256 is unavailable: use this
		 * exact canonical composite as the registry uniqueness key. Do not use a
		 * task name as the fallback key.
		 */
		fallback_source_identity = file_id;
		if(fallback_source_identity == "")
		{
			fallback_source_identity = normalized_source_name;
		}
		fallback_idempotency_key = fallback_source_identity + "::" + normalized_action_text;

		item = Map();
		item.put("action_text", action_text);
		item.put("owner_raw", owner_raw);
		item.put("owner_resolution", owner_resolution);
		item.put("owner_id", resolved_owner_id);
		item.put("detected_owners", detected_owners);
		item.put("due_date_text", due_date_text);
		item.put("source_file_name", file_name);
		item.put("action_hash", action_hash);
		item.put("fallback_idempotency_key", fallback_idempotency_key);
		items.add(item);
	}

	result.put("items", items);
	result.put("item_count", items.size());
	result.put("errors", errors);
	return result;
}

