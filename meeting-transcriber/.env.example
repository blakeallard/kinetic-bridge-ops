# Copy to .env for local dev. On Railway, set these in the service Variables tab.
# Do NOT commit the real .env.

# Server
PORT=8000
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Zoho WorkDrive OAuth
# Create a self-client at https://api-console.zoho.com to get these.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Adjust the domains to your Zoho data center (.com, .eu, .in, .com.au, ...)
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/workdrive/api/v1
