# Copy to .env for local dev. On Railway, set these in the service Variables tab.
# Do NOT commit the real .env.

# Server
PORT=8000
LOG_LEVEL=INFO

# OpenAI (TODO 2 & 3)
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Zoho WorkDrive OAuth (TODO 1 & 5)
# Create a self-client at https://api-console.zoho.com to get these.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Adjust the domain to your Zoho data center (.com, .eu, .in, .com.au, ...)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_WORKDRIVE_API=https://www.zohoapis.com/workdrive/api/v1
