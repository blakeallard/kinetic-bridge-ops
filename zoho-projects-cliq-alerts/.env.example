# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Zoho Projects Status Alert Script
# Copy this to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Zoho OAuth credentials
# Create a self-client at: https://api-console.zoho.com/
# Required scopes: ZohoProjects.tasks.ALL, ZohoProjects.portals.READ
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Projects — portal ID (numeric, from portal URL or get_portals API)
# Bevco portal ID: 898600220
ZOHO_PROJECTS_PORTAL_ID=898600220

# Zoho Projects — project ID (numeric, from get_projects_list API)
# Bevco BE-9 project ID: 2543412000001324010
ZOHO_PROJECT_ID=2543412000001324010

# Zoho Cliq — full channel webhook URL including zapikey
# Get from: Cliq → Settings → Bots & Tools → Webhook Tokens → Get Webhook URL
# Select module: Channels → pick your channel → copy full URL
# Format: https://cliq.zoho.com/api/v2/channelsbyname/{channel-unique-name}/message?zapikey={token}
CLIQ_CHANNEL_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/your-channel-name/message?zapikey=your_token_here
